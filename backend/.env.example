PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/scenesolver?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
GROQ_API_KEY=your_groq_api_key
SESSION_SECRET=your_session_secret_key
CORS_ORIGIN=http://localhost:5173
FLASK_SERVICE_URL=http://127.0.0.1:5001

# Optional Email OTP Configuration (If blank, developer OTP 123456 is active)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Optional Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
BACKEND_URL=http://localhost:5000
